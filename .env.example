# Server Runtime Configuration (Required for Phase 1)
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Authentication - Clerk (Required in Phase 2+)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder

# Database - MongoDB Atlas (Required in Phase 3+)
MONGODB_URI=mongodb+srv://placeholder:placeholder@cluster.mongodb.net
MONGODB_DB_NAME=explobook

# Local AI / Inference - Ollama & Gemma (Required in Phase 4+)
OLLAMA_BASE_URL=http://127.0.0.1:11434
GEMMA_MODEL=gemma3:4b-it-q4_K_M
EMBEDDING_MODEL=nomic-embed-text

# Voice Services - ElevenLabs (Required in Phase 10+)
ELEVENLABS_API_KEY=el_placeholder
ELEVENLABS_RECOMMENDATION_VOICE_ID=placeholder_voice_id
ELEVENLABS_EXPEDITION_VOICE_ID=placeholder_expedition_voice_id
ELEVENLABS_ORB_VOICE_ID=placeholder_orb_voice_id
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# External Book Search - SerpApi (Required in Phase 12+)
SERPAPI_KEY=placeholder_serpapi_key

# Observability - Sentry (Required in Phase 13+)
SENTRY_DSN=https://placeholder@sentry.io/0
SENTRY_ENVIRONMENT=development
